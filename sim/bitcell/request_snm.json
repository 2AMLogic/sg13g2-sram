{
  "engine": "ngspice",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ss",
      "mos_ff",
      "mos_sf",
      "mos_fs"
    ],
    "supply_v": {
      "vdd": [
        1.08,
        1.2,
        1.32
      ]
    },
    "temperature_c": [
      -40,
      25,
      125
    ]
  },
  "netlist": "bench_snm.cir",
  "backend": "batch",
  "analysis": {
    "kind": "dc",
    "args": "Vu 0 1 0.005"
  },
  "measurements": [
    {
      "name": "vdd_check",
      "unit": "V",
      "expr": "v(vdd)[0]"
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "waveforms": true,
    "keep_artifacts": true,
    "timeout_s": 60
  }
}
