{
  "engine": "ngspice",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOSlv.lib"
  },
  "corners": {
    "process": [
      "mos_tt_mismatch"
    ],
    "supply_v": {
      "vdd": [
        1.2
      ]
    },
    "temperature_c": [
      27
    ]
  },
  "netlist": "bench_write_search.cir",
  "backend": "batch",
  "analysis": {
    "kind": "tran",
    "args": "5p 3.5n"
  },
  "measurements": [
    {
      "name": "zero_score",
      "unit": "V",
      "expr": "v(score)[length(v(score))-1]"
    },
    {
      "name": "write_margin_v",
      "unit": "V",
      "search": {
        "source": "Vlevel",
        "lo": 0.0,
        "hi": 0.8,
        "direction": "falling",
        "tol": 0.00625,
        "max_iter": 8,
        "analysis": {
          "kind": "tran",
          "args": "5p 3.5n"
        },
        "predicate": {
          "expr": "v(score) < 0",
          "at": "end"
        }
      }
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
    ],
    "timeout_s": 300
  },
  "monte_carlo": {
    "n": 10,
    "seed": 20261029,
    "vary": "mismatch"
  },
  "batch": {
    "job_ceiling_check": "split",
    "max_concurrent_jobs": 2
  }
}
